{
  "name": "tarea2-ia-ui",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve biblioteca",
    "build": "ng build biblioteca && ng build clinica",
    "start:biblioteca": "ng serve biblioteca",
    "start:clinica": "ng serve clinica --port 4300",
    "build:pages": "ng build biblioteca --base-href /tarea2-ia-ui/biblioteca/ && ng build clinica --base-href /tarea2-ia-ui/clinica/ && node scripts/ensamblar-pages.mjs",
    "preview": "node scripts/servir-local.mjs",
    "capturas": "node scripts/capturas.mjs",
    "build:electron": "ng build biblioteca --configuration production --base-href ./",
    "electron": "npm run build:electron && electron .",
    "electron:dist": "npm run build:electron && electron-builder --publish never"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "dexie": "^4.4.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "electron/main.cjs",
  "description": "Tarea 2: biblioteca (escritorio) y clinica (web) generadas con Claude Code",
  "author": "Sergio Jair Caballero Martinez",
  "build": {
    "appId": "mx.unam.tarea2.biblioteca",
    "productName": "Biblioteca",
    "copyright": "2026 Sergio Jair Caballero Martinez",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/biblioteca/browser/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Biblioteca-${version}-Windows-Setup.${ext}",
      "shortcutName": "Biblioteca"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "Biblioteca-${version}-macOS.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "artifactName": "Biblioteca-${version}-Linux.${ext}"
    }
  }
}
